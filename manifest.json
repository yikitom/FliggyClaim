{
  "manifest_version": 3,
  "name": "FliggyClaim 报销助手",
  "version": "0.1.0",
  "description": "批量上传报销凭证，自动识别字段并填写到飞猪报销系统。",
  "default_locale": "zh_CN",
  "action": {
    "default_title": "FliggyClaim 报销助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://tae.alibaba-inc.com/*",
    "https://*.alibaba-inc.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tae.alibaba-inc.com/expense/*",
        "https://*.alibaba-inc.com/expense/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
